---
import "../../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Reset Password | Celia</title>
        <meta name="theme-color" content="#020617" />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-zinc-950 font-sans min-h-screen flex items-center justify-center p-4"
    >
        <div id="reset-root"></div>

        <script>
            import { createRoot } from "react-dom/client";
            import { createElement } from "react";
            import { ResetPasswordForm } from "../../components/auth/ResetPasswordForm";

            const root = document.getElementById("reset-root");
            if (root) {
                createRoot(root).render(createElement(ResetPasswordForm));
            }
        </script>
    </body>
</html>

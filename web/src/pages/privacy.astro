        }

        .container {
            max-width: 760px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 3rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #27272a;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
            text-decoration: none;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #ffffff;
            margin-top: 2rem;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .meta {
            font-size: 0.875rem;
            color: #71717a;
            margin-bottom: 2.5rem;
        }

        h2 {
            font-size: 1.125rem;
            font-weight: 600;
            color: #ffffff;
            margin-top: 2.5rem;
            margin-bottom: 0.75rem;
        }

        h3 {
            font-size: 0.95rem;
            font-weight: 600;
            color: #a1a1aa;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        p {
            margin-bottom: 1rem;
            font-size: 0.9375rem;
        }

        ul {
            padding-left: 1.5rem;
            margin-bottom: 1rem;
        }

        li {
            margin-bottom: 0.35rem;
            font-size: 0.9375rem;
        }

        .callout {
            background: #18181b;
            border: 1px solid #3f3f46;
            border-left: 3px solid #ef4444;
            border-radius: 6px;
            padding: 1rem 1.25rem;
            margin: 1.25rem 0;
            font-size: 0.9rem;
        }

        .callout.green {
            border-left-color: #22c55e;
        }

        .callout strong {
            color: #ffffff;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.25rem 0;
            font-size: 0.875rem;

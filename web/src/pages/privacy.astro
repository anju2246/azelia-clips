// Política de Privacidad — azelia.ai
// Efectiva: Abril 2026
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Política de Privacidad | Azelia</title>
    <meta name="description" content="Política de privacidad de Azelia — herramienta de IA para podcasters." />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

---
import "../styles/global.css";
import { OnboardingWizard } from "../components/onboarding/OnboardingWizard";
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Setup | Azelia Clips</title>
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script>
            import { supabase } from "../lib/supabase";

            // Enforce Auth OR Prevent looped routing
            window.addEventListener("DOMContentLoaded", async () => {
                try {
                    // 1. Auth Guard
                    const { data: authData } = await supabase.auth.getSession();
                    if (!authData?.session) {
                        window.location.replace("/login");
                        return;
                    }

                    // 2. Prevent looping if they already completed onboarding
                    const res = await fetch("/api/auth/onboarding-status", {
                        headers: {
                            Authorization: `Bearer ${authData.session.access_token}`,
                        },
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (data.onboarding_complete) {
                            // Don't bounce to /dashboard if the URL carries an
                            // OAuth callback (Google YouTube). The wizard's
                            // init handler needs a chance to POST the code to
                            // /sync-with-code so the YT connection persists.
                            // Without this guard, post-OAuth landings on a
                            // post-onboarding account silently lose the code
                            // and the user thinks YouTube didn't connect.
                            const params = new URLSearchParams(window.location.search);
                            if (!params.has("code")) {
                                window.location.replace("/dashboard");
                                return;
                            }
                        }
                    }
                } catch (e) {
                    console.error("Failed to fetch settings or auth", e);
                }
            });
        </script>
    </head>
    <body
        class="bg-zinc-950 text-zinc-100 antialiased selection:bg-brand-500/30 font-sans min-h-screen relative flex items-center justify-center p-4 overflow-y-auto"
    >
        <!-- Background Effects -->
        <div class="noise-overlay fixed inset-0 z-0"></div>
        <div class="grid-overlay fixed inset-0 z-0 opacity-50"></div>

        <div class="relative z-10 w-full max-w-2xl mx-auto py-12">
            <!-- Logo -->
            <div class="flex justify-center mb-8">
                <img
                    src="/favicon.svg"
                    alt="Azelia Clips"
                    class="w-14 h-14 rounded-2xl shadow-[0_0_30px_rgba(168,85,247,0.3)]"
                />
            </div>

            <!-- React Wizard Component -->
            <OnboardingWizard client:only="react" />
        </div>
    </body>
</html>

---
import "../styles/global.css";
import { OnboardingWizard } from "../components/onboarding/OnboardingWizard";
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Setup | Azelia Clips</title>
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script>
            // Local-first MVP: if onboarding is already done, jump to dashboard.
            // Don't bounce if the URL carries an OAuth callback (?code=...) —
            // the wizard's init handler needs the code to finish YouTube connect.
            window.addEventListener("DOMContentLoaded", () => {
                if (localStorage.getItem("az_onboarding_complete") === "true") {
                    const params = new URLSearchParams(window.location.search);
                    if (!params.has("code")) {
                        window.location.replace("/dashboard");
                    }
                }
            });
        </script>
    </head>
    <body
        class="bg-zinc-950 text-zinc-100 antialiased selection:bg-brand-500/30 font-sans min-h-screen relative flex items-center justify-center p-4 overflow-y-auto"
    >
        <!-- Background Effects -->
        <div class="noise-overlay fixed inset-0 z-0"></div>
        <div class="grid-overlay fixed inset-0 z-0 opacity-50"></div>

        <div class="relative z-10 w-full max-w-2xl mx-auto py-12">
            <!-- Logo -->
            <div class="flex justify-center mb-8">
                <img
                    src="/favicon.svg"
                    alt="Azelia Clips"
                    class="w-14 h-14 rounded-2xl shadow-[0_0_30px_rgba(168,85,247,0.3)]"
                />
            </div>

            <!-- React Wizard Component -->
            <OnboardingWizard client:only="react" />
        </div>
    </body>
</html>

---
import "../styles/global.css";
import { OnboardingWizard } from "../components/onboarding/OnboardingWizard";
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Setup | Azelia Clips</title>
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <script>
            import { supabase } from "../lib/supabase";

            // Enforce Auth OR Prevent looped routing
            window.addEventListener("DOMContentLoaded", async () => {
                try {
                    // 1. Auth Guard
                    const { data: authData } = await supabase.auth.getSession();
                    if (!authData?.session) {
                        window.location.replace("/login");
                        return;
                    }

                    // 2. Prevent looping if they already have keys
                    const res = await fetch("/api/settings", {
                        headers: {
                            Authorization: `Bearer ${authData.session.access_token}`,
                        },
                    });
                    if (res.ok) {
                        const data = await res.json();
                        const hasKey = !!(
                            data.groq_api_key ||
                            data.openai_api_key ||
                            data.anthropic_api_key ||
                            data.gcp_project_id
                        );
                        if (hasKey) {
                            window.location.replace("/dashboard");
                        }
                    }
                } catch (e) {
                    console.error("Failed to fetch settings or auth", e);
                }
            });
        </script>
    </head>
    <body
        class="bg-zinc-950 text-zinc-100 antialiased selection:bg-brand-500/30 font-sans min-h-screen relative flex items-center justify-center p-4 overflow-y-auto"
    >
        <!-- Background Effects -->
        <div class="noise-overlay fixed inset-0 z-0"></div>
        <div class="grid-overlay fixed inset-0 z-0 opacity-50"></div>

        <div class="relative z-10 w-full max-w-2xl mx-auto py-12">
            <!-- Logo placement -->
            <div class="flex justify-center mb-8">
                <div
                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center shadow-[0_0_30px_rgba(168,85,247,0.3)]"
                >
                    <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>

            <!-- React Wizard Component -->
            <OnboardingWizard client:only="react" />
        </div>
    </body>
</html>

---
import "../styles/global.css";
import { Sidebar } from "../components/layout/Sidebar";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Azelia Clips - AI-powered podcast clip generator"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Azelia</title>
    <meta name="theme-color" content="#020617" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Clip-template editor preview fonts (so the WYSIWYG mockup renders the
         actually-selected family instead of a generic fallback). -->
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Montserrat:wght@400;500;700;800&family=Oswald:wght@400;500;700&family=Poppins:wght@400;500;700;800&family=Inter:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- KILL PWA CACHE -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          let hasUnregistered = false;
          for(let registration of registrations) {
            registration.unregister();
            hasUnregistered = true;
          }
          if (hasUnregistered) {
            console.log('Unregistered stale service workers. Reloading...');
            window.location.reload();
          }
        });
      }
    </script>
    <!-- End Kill PWA -->
    <script>
      // Local-first MVP: no auth, no central onboarding API.
      // Onboarding is considered done if localStorage flag is set.
      // The flag is written by OnboardingWizard.handleFinish.
      window.addEventListener("DOMContentLoaded", () => {
        if (localStorage.getItem("az_onboarding_complete") !== "true") {
          window.location.replace("/onboarding");
        }
      });
    </script>
  </head>
  <body
    class="bg-zinc-950 text-zinc-100 antialiased selection:bg-brand-500/30 font-sans min-h-screen relative overflow-hidden flex"
  >
    <!-- Background Effects -->
    <div class="noise-overlay" style="pointer-events:none;z-index:0"></div>
    <div class="grid-overlay" style="pointer-events:none;z-index:0"></div>

    <!-- Layout Structure -->
    <Sidebar currentPath={currentPath} client:load />

    <div
      class="flex-1 flex flex-col h-screen relative w-full overflow-hidden"
      style="z-index:10"
    >
      <main class="flex-1 overflow-y-auto p-8 pt-10 scroll-smooth">
        <div class="max-w-7xl mx-auto w-full h-full">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

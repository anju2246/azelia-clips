---
import "../styles/global.css";
import { Sidebar } from "../components/layout/Sidebar";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Celia Clips - AI-powered podcast clip generator"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Celia</title>
    <meta name="theme-color" content="#020617" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script>
      import { supabase } from "../lib/supabase";

      // Auth & Onboarding Gate
      window.addEventListener("DOMContentLoaded", async () => {
        try {
          // 1. Auth Guard: Check if user is logged in
          const { data: authData } = await supabase.auth.getSession();
          if (!authData?.session) {
            window.location.replace("/login");
            return; // Stop execution
          }

          // 2. Onboarding Gate: Enforce API Key Configuration
          const res = await fetch("/api/settings", {
            headers: {
              Authorization: `Bearer ${authData.session.access_token}`,
            },
          });
          if (res.ok) {
            const data = await res.json();
            const hasKey = !!(
              data.groq_api_key ||
              data.openai_api_key ||
              data.anthropic_api_key ||
              data.gcp_project_id
            );

            // If the user has zero AI engine keys configured, they cannot process anything.
            if (!hasKey) {
              window.location.replace("/onboarding");
            }
          }
        } catch (e) {
          console.error("Failed to check auth/onboarding status", e);
        }
      });
    </script>
  </head>
  <body
    class="bg-zinc-950 text-zinc-100 antialiased selection:bg-brand-500/30 font-sans min-h-screen relative overflow-hidden flex"
  >
    <!-- Background Effects -->
    <div class="noise-overlay"></div>
    <div class="grid-overlay"></div>

    <!-- Layout Structure -->
    <Sidebar currentPath={currentPath} client:load />

    <div
      class="flex-1 flex flex-col h-screen relative z-10 w-full overflow-hidden"
    >
      <main class="flex-1 overflow-y-auto p-8 pt-10 scroll-smooth">
        <div class="max-w-7xl mx-auto w-full h-full">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Environment files — never commit any .env. The frontend reads PUBLIC_*
# vars at build time from the user's local web/.env; nothing belongs in git.
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# IDE
.idea/
.vscode/
*.swp

# Output
output/
/clips/
external_drive

# Video/Audio files (never commit)
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.ass
*.srt

# Model cache
models/
.cache/

# Transcripts (keep .json examples)
!examples/*.json

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.egg-info/
autoeditingsfc.egg-info/
web/package-lock.json

# Debug/runtime logs
*.log
supabase_schema.sql

# SQLite databases — NUCLEAR: block ALL .db/.sqlite files globally
# This ensures no local user data is EVER accidentally committed
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Model weights (auto-downloaded)
*.pt

# Local configuration (never commit)
local_config/

# Private development data (NEVER commit)
private/

# Server runtime data
server/data/
src.bak/

# Personal job data — curation, briefs, candidate sessions, learnings.
# NEVER commit: these are the user's own clips, transcripts and learned rules.
data/
secrets.env
*.env
!*.env.example
!.env.example

# Scratch/test scripts (exploratory, never commit)
_scratch/

# MCP server config (local only)
.mcp.json

# Claude Code workspace — NEVER commit. Holds local settings AND the user's
# personal memory/brain notes (.claude/projects/**/memory/*.md). Ignore the
# whole dir; add `!` exceptions if a specific shared agent ever needs tracking.
.claude/

# Playwright test artifacts
web/test-results/
.env.*-backup

# Playwright auth state — never commit; contains live session tokens
web/e2e/.auth/
out/
_logs/
# Loop-engineering / SDD working docs (no se trackean)
goal.md
spec.md
plan.md
tasks.md
constitution.md
learnings.md
docs/multi-profile/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Environment files — root .env has private keys (never commit)
.env
# web/.env only has the public anon key — safe to commit
!web/.env

# IDE
.idea/
.vscode/
*.swp

# Output
output/
/clips/
external_drive

# Video/Audio files (never commit)
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.ass
*.srt

# Model cache
models/
.cache/

# Transcripts (keep .json examples)
!examples/*.json

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.egg-info/
autoeditingsfc.egg-info/
web/package-lock.json

# Debug/runtime logs
*.log
supabase_schema.sql

# SQLite databases — NUCLEAR: block ALL .db/.sqlite files globally
# This ensures no local user data is EVER accidentally committed
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Model weights (auto-downloaded)
*.pt

# Local configuration (never commit)
local_config/

# Private development data (NEVER commit)
private/

# Server runtime data
server/data/
src.bak/

# Scratch/test scripts (exploratory, never commit)
_scratch/

# MCP server config (local only)
.mcp.json
.claude/settings.json

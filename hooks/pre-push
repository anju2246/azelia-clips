#!/usr/bin/env bash
# Security/data-leak guardrail — blocks pushing secrets or personal data.
# Installed into .git/hooks/pre-push by scripts/install-git-hooks.sh.
#
# git feeds the hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# For each pushed ref we scan the commits not already on the remote.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GATE="$REPO_ROOT/scripts/security_gate.py"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # branch deletion — nothing to scan
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"                              # new branch — scan its full history
  else
    range="$remote_sha..$local_sha"                 # update — scan only new commits
  fi
  if ! python3 "$GATE" --range "$range"; then
    status=2
  fi
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "🚫 push blocked by security_gate. Fix the findings above and retry."
  echo "   (emergency bypass, use with care: git push --no-verify)"
fi
exit "$status"
